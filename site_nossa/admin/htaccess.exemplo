# ============================================
# PROTEÇÃO DO PAINEL ADMINISTRATIVO
# ============================================
# Este arquivo protege o painel com autenticação básica
# 
# COMO USAR:
# 1. Renomeie este arquivo para ".htaccess"
# 2. Crie um arquivo ".htpasswd" com suas credenciais
# 3. Atualize o caminho do arquivo .htpasswd abaixo
#
# Para gerar a senha, use:
# https://www.htaccesstools.com/htpasswd-generator/
# ============================================

AuthType Basic
AuthName "Painel Administrativo - Nossa Sertaneja"
AuthUserFile /home/seu_usuario/.htpasswd
Require valid-user

# Opcional: Permitir acesso à API sem autenticação
<FilesMatch "^(get_|add_|edit_|delete_)">
    Satisfy Any
    Allow from all
</FilesMatch>
